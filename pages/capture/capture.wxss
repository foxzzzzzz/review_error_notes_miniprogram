.capture {
  padding: 16px;
}

.info-bar {
  font-size: 16px;
  font-weight: 600;
  text-align: center;
  padding: 12px 0;
  background: #f0f9ff;
  border-radius: 8px;
  margin-bottom: 16px;
}

.camera-area {
  background: #f5f5f5;
  border: 2px dashed #ccc;
  border-radius: 12px;
  min-height: 200px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16px;
  overflow: hidden;
}

.camera-area image {
  width: 100%;
}

.preview-strip {
  margin: -8px 0 16px;
  white-space: nowrap;
}

.preview-thumbnails {
  display: inline-flex;
  gap: 8px;
}

.preview-thumbnail {
  width: 58px;
  height: 58px;
  border: 2px solid transparent;
  border-radius: 8px;
}

.preview-thumbnail.selected {
  border-color: #1aad19;
}

.placeholder {
  color: #999;
  font-size: 16px;
}

.upload-list {
  margin-bottom: 16px;
}

.background-list {
  margin-bottom: 16px;
}

.section-title {
  display: block;
  margin: 0 0 8px 2px;
  color: #526052;
  font-size: 14px;
  font-weight: 600;
}

.background-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #6d796e;
  font-size: 13px;
}

.background-heading .section-title {
  margin-bottom: 8px;
}

.batch-subject-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  margin-bottom: 8px;
  background: #f4fbf4;
  border-radius: 8px;
}

.batch-subject-label {
  color: #36513a;
  font-size: 14px;
}

.upload-item {
  display: flex;
  align-items: center;
  padding: 12px;
  background: #fff;
  border-radius: 8px;
  margin-bottom: 8px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}

.upload-region {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.upload-page-region {
  flex: 1;
  justify-content: flex-start;
}

.upload-status-region,
.upload-subject-region {
  justify-content: center;
}

.upload-page {
  font-size: 14px;
  white-space: nowrap;
}

.status-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  min-width: 0;
}

.status {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 4px;
  white-space: nowrap;
}

.status-pending {
  color: #f60;
  background: #fff3e0;
}

.status-processing {
  color: #1976d2;
  background: #e3f2fd;
}

.status-segmented {
  color: #1976d2;
  background: #e3f2fd;
}

.status-confirmed {
  color: #388e3c;
  background: #e8f5e9;
}

.status-needs_review {
  color: #8a6700;
  background: #fff8d7;
}

.status-failed {
  color: #c62828;
  background: #ffebee;
}

.failed-status-link {
  text-decoration: underline;
}

.retry-btn {
  margin: 0 0 0 6px;
  padding: 0 6px;
  color: #c62828;
  background: transparent;
  font-size: 12px;
  line-height: 20px;
}

.retry-btn::after {
  border: 0;
}

.review-btn {
  flex: none;
  min-width: 52px;
  margin: 0;
  padding: 0 6px;
  color: #1aad19;
  background: #fff;
  border: 1px solid #1aad19;
  border-radius: 4px;
  font-size: 12px;
  line-height: 26px;
  white-space: nowrap;
}

.review-btn::after {
  border: 0;
}

.subject-tag {
  height: 20px;
  line-height: 20px;
  box-sizing: border-box;
  color: #1aad19;
  font-size: 13px;
  padding: 0 8px;
  border: 1px solid #1aad19;
  border-radius: 4px;
  text-align: center;
}

.submit-btn {
  background: #1aad19;
  color: #fff;
  border-radius: 8px;
  font-size: 16px;
  padding: 12px;
  width: 100%;
}

.submit-btn[disabled] {
  background: #ccc;
}

.settings-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 20, 16, 0.48);
}

.settings-sheet {
  width: 100%;
  padding: 24px 20px calc(14px + env(safe-area-inset-bottom));
  border-radius: 18px 18px 0 0;
  background: #fff;
  box-sizing: border-box;
}

.settings-title {
  font-size: 20px;
  font-weight: 700;
}

.settings-copy {
  margin: 8px 0 20px;
  color: #8b9188;
  font-size: 13px;
}

.settings-row {
  display: flex;
  justify-content: space-between;
  padding: 16px 2px;
  border-top: 1px solid #eef0ed;
  font-size: 16px;
}

.settings-row text:last-child {
  color: #25823a;
}

.cancel-settings {
  margin-top: 8px;
  background: transparent;
  color: #858b82;
  font-size: 14px;
}

.cancel-settings::after {
  border: 0;
}
