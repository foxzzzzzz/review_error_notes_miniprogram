<view class="capture">
  <view class="info-bar">
    📖 {{gradeSet && semesterSet ? grades[gradeIndex] + ' · ' + semesters[semester] : '请先设置年级和册别'}}
  </view>

  <view class="camera-area" bindtap="takePhoto">
    <image wx:if="{{previewUrl}}" src="{{previewUrl}}" mode="widthFix" />
    <view wx:else class="placeholder">点击拍照或选择图片</view>
  </view>

  <view class="upload-list" wx:if="{{uploads.length > 0}}">
    <view class="upload-item" wx:for="{{uploads}}" wx:key="id">
      <text class="upload-page">📄 第{{index+1}}页</text>
      <text class="status upload-status status-{{item.status}}">{{statusText[item.status]}}</text>
      <text class="subject-tag" bindtap="onSubjectTap" data-index="{{index}}">
        {{item.subject ? (subjectMap[item.subject] || item.subject) : '点击选择科目'}}
      </text>
    </view>
  </view>

  <button class="submit-btn" bindtap="submitAll" disabled="{{uploading}}">确认提交</button>

  <view wx:if="{{showStudentSettings}}" class="settings-mask">
    <view class="settings-sheet">
      <view class="settings-title">先完善学生设置</view>
      <view class="settings-copy">用于匹配题目范围，本次保存后会继续提交图片</view>
      <picker mode="selector" range="{{grades}}" value="{{settingsGradeIndex}}" bindchange="onSettingsGradeChange">
        <view class="settings-row">
          <text>年级</text>
          <text>{{grades[settingsGradeIndex]}} ›</text>
        </view>
      </picker>
      <picker mode="selector" range="{{semesters}}" value="{{settingsSemester}}" bindchange="onSettingsSemesterChange">
        <view class="settings-row">
          <text>册别</text>
          <text>{{semesters[settingsSemester]}} ›</text>
        </view>
      </picker>
      <button class="submit-btn" loading="{{uploading}}" bindtap="onSaveStudentSettings">保存并继续</button>
      <button class="cancel-settings" disabled="{{uploading}}" bindtap="onCloseStudentSettings">取消</button>
    </view>
  </view>
</view>
