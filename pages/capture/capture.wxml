<view class="capture">
  <view class="info-bar">
    📖 {{gradeSet && semesterSet ? grades[gradeIndex] + ' · ' + semesters[semester] : '请先设置年级和册别'}}
  </view>

  <view class="camera-area" bindtap="takePhoto">
    <image wx:if="{{previewUrl}}" src="{{previewUrl}}" mode="widthFix" />
    <view wx:else class="placeholder">点击拍照或选择图片</view>
  </view>

  <scroll-view wx:if="{{uploads.length > 1}}" scroll-x class="preview-strip">
    <view class="preview-thumbnails">
      <image wx:for="{{uploads}}" wx:key="id" class="preview-thumbnail {{previewUploadId === item.id ? 'selected' : ''}}" src="{{item.path}}" mode="aspectFill" data-id="{{item.id}}" bindtap="selectPreview" />
    </view>
  </scroll-view>

  <view class="upload-list" wx:if="{{uploads.length > 0}}">
    <text class="section-title">本次待上传</text>
    <view class="batch-subject-row">
      <text class="batch-subject-label">批量设置科目</text>
      <view class="subject-tag" bindtap="onBatchSubjectTap">{{batchSubject ? (subjectMap[batchSubject] || batchSubject) : '点击选择科目'}}</view>
    </view>
    <view class="upload-item" wx:for="{{uploads}}" wx:key="id">
      <view class="upload-region upload-page-region">
        <text class="upload-page">📄 第{{index+1}}页</text>
      </view>
      <view class="upload-region upload-status-region">
        <text class="status status-{{item.status}}">{{statusText[item.status]}}</text>
        <button wx:if="{{item.status === 'failed' && item.imageId}}" class="retry-btn" bindtap="onRetryTap" data-index="{{index}}">重试</button>
        <button wx:if="{{item.status === 'needs_review' && item.imageId}}" class="retry-btn" bindtap="onReviewTap" data-image-id="{{item.imageId}}">去确认</button>
      </view>
      <view class="upload-region upload-subject-region">
        <view class="subject-tag" bindtap="onSubjectTap" data-index="{{index}}">{{item.subject ? (subjectMap[item.subject] || item.subject) : '点击选择科目'}}</view>
      </view>
    </view>
  </view>

  <view class="background-list" wx:if="{{backgroundUploads.length > 0}}">
    <view class="background-heading" bindtap="toggleBackgroundUploads">
      <text class="section-title">后台处理中任务（{{backgroundUploads.length}}）</text>
      <text>{{showBackgroundUploads ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{showBackgroundUploads}}">
      <view class="upload-item" wx:for="{{backgroundUploads}}" wx:key="imageId">
        <view class="upload-region upload-page-region">
          <text class="upload-page">已提交图片</text>
        </view>
        <view class="upload-region upload-status-region">
          <text class="status status-{{item.status}}">{{statusText[item.status]}}</text>
          <button wx:if="{{item.status === 'failed'}}" class="retry-btn" bindtap="onBackgroundRetryTap" data-image-id="{{item.imageId}}">重试</button>
          <button wx:if="{{item.status === 'needs_review'}}" class="retry-btn" bindtap="onReviewTap" data-image-id="{{item.imageId}}">去确认</button>
        </view>
        <view class="upload-region upload-subject-region">
          <text>{{item.subject ? (subjectMap[item.subject] || item.subject) : '未设置科目'}}</text>
        </view>
      </view>
    </view>
  </view>

  <button class="submit-btn" bindtap="submitAll" disabled="{{uploading}}">确认提交</button>

  <view wx:if="{{showStudentSettings}}" class="settings-mask">
    <view class="settings-sheet">
      <view class="settings-title">先完善学生设置</view>
      <view class="settings-copy">用于匹配题目范围，本次保存后会继续提交图片</view>
      <picker mode="selector" range="{{grades}}" value="{{settingsGradeIndex}}" bindchange="onSettingsGradeChange">
        <view class="settings-row">
          <text>年级</text>
          <text>{{grades[settingsGradeIndex]}} ›</text>
        </view>
      </picker>
      <picker mode="selector" range="{{semesters}}" value="{{settingsSemester}}" bindchange="onSettingsSemesterChange">
        <view class="settings-row">
          <text>册别</text>
          <text>{{semesters[settingsSemester]}} ›</text>
        </view>
      </picker>
      <button class="submit-btn" loading="{{uploading}}" bindtap="onSaveStudentSettings">保存并继续</button>
      <button class="cancel-settings" disabled="{{uploading}}" bindtap="onCloseStudentSettings">取消</button>
    </view>
  </view>
</view>
