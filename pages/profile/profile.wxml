<view class="profile">
  <view wx:if="{{!loggedIn}}" class="logged-out-card">
    <view class="logged-out-mark">错</view>
    <view class="logged-out-title">登录后查看学习档案</view>
    <view class="logged-out-copy">错题、练习记录和学生设置会安全保存在当前账户中</view>
    <button class="primary-button" loading="{{loading}}" bindtap="onLogin">微信登录</button>
  </view>

  <view wx:elif="{{pendingDeletion}}" class="pending-card">
    <view class="pending-mark">留</view>
    <view class="pending-title">账户正在保留期</view>
    <view class="pending-copy">当前账户已申请注销，学习数据暂时保留。恢复账户后可继续使用错题与练习记录。</view>
    <view wx:if="{{deletionDueText}}" class="pending-deadline">
      预计永久删除时间（北京时间）
      <text>{{deletionDueText}}</text>
    </view>
    <button class="primary-button" loading="{{loading}}" disabled="{{loading}}" bindtap="onRecoverDeletion">恢复账户</button>
    <button class="pending-exit" disabled="{{loading}}" bindtap="onExitPendingAccount">退出，不恢复</button>
  </view>

  <block wx:else>
    <view class="identity-card">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarTempPath || avatarUrl}}" class="avatar-image" src="{{avatarTempPath || avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-fallback">{{avatarInitial}}</view>
        <view class="avatar-edit">编辑</view>
      </button>
      <view class="identity-copy">
        <view class="account-name">{{nickname || '微信用户'}}</view>
        <view class="account-note">当前账户</view>
      </view>
    </view>

    <view class="section student-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">当前学生</view>
          <input class="student-name" value="{{studentName}}" maxlength="20" bindblur="onStudentNameBlur" />
        </view>
        <view class="student-badge">{{gradeSet && semesterSet ? grades[gradeIndex] + ' · ' + semesters[semester] : '待完善'}}</view>
      </view>
      <view class="setting-row">
        <view>
          <view class="setting-label">年级</view>
          <view class="setting-help">用于匹配适合的题目范围</view>
        </view>
        <picker mode="selector" range="{{grades}}" value="{{gradeIndex}}" bindchange="onGradeChange">
          <view class="setting-value">{{gradeSet ? grades[gradeIndex] : '请选择'}} <text>›</text></view>
        </picker>
      </view>
      <view class="setting-row">
        <view>
          <view class="setting-label">册别</view>
          <view class="setting-help">生成练习时沿用此设置</view>
        </view>
        <picker mode="selector" range="{{semesters}}" value="{{semester}}" bindchange="onSemesterChange">
          <view class="setting-value">{{semesterSet ? semesters[semester] : '请选择'}} <text>›</text></view>
        </picker>
      </view>
    </view>

    <view class="section">
      <view class="section-title">学习概览</view>
      <view class="stats-grid">
        <view class="stat-card stat-total" data-filter="total" bindtap="onStatTap">
          <view class="stat-value">{{stats.total}}</view>
          <view class="stat-label">全部错题</view>
        </view>
        <view class="stat-card" data-filter="month" bindtap="onStatTap">
          <view class="stat-value">{{stats.monthNew}}</view>
          <view class="stat-label">本月新增</view>
        </view>
        <view class="stat-card" data-filter="needsReview" bindtap="onStatTap">
          <view class="stat-value">{{stats.needsReview}}</view>
          <view class="stat-label">待复习</view>
        </view>
        <view class="stat-card stat-mastered" data-filter="mastered" bindtap="onStatTap">
          <view class="stat-value">{{stats.mastered}}</view>
          <view class="stat-label">已掌握</view>
        </view>
      </view>
    </view>

    <view class="section account-section">
      <view class="section-title">账户与安全</view>
      <view class="account-row">
        <view>
          <view class="setting-label">手机号</view>
          <view class="setting-help">{{phoneBound ? phoneMasked : '用于账户恢复与数据合并'}}</view>
        </view>
        <view wx:if="{{phoneBound}}" class="future-pill">已绑定</view>
        <button
          wx:else
          class="phone-button"
          open-type="getPhoneNumber"
          loading="{{loading}}"
          disabled="{{loading}}"
          bindgetphonenumber="onGetPhoneNumber"
        >绑定手机号</button>
      </view>
      <view class="logout-row" bindtap="onLogout">退出当前账户</view>
      <view class="danger-zone">
        <view>
          <view class="danger-label">注销账户</view>
          <view class="setting-help">申请后进入可恢复保留期</view>
        </view>
        <view class="danger-action {{deletionConfirming ? 'action-disabled' : ''}}" bindtap="onRequestDeletion">申请注销</view>
      </view>
    </view>
  </block>

  <view wx:if="{{showProfilePrompt && !pendingDeletion}}" class="prompt-mask">
    <view class="prompt-card">
      <view class="prompt-title">完善你的账户资料</view>
      <view class="prompt-copy">头像和昵称仅用于错题本内展示，也可以稍后再设置</view>
      <button class="prompt-avatar" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarTempPath || avatarUrl}}" src="{{avatarTempPath || avatarUrl}}" mode="aspectFill"></image>
        <view wx:else>{{avatarInitial}}</view>
        <text>选择头像</text>
      </button>
      <view class="nickname-field">
        <text>昵称</text>
        <input type="nickname" maxlength="20" value="{{nicknameDraft}}" placeholder="选择或填写昵称" bindinput="onNicknameInput" />
      </view>
      <button class="primary-button" loading="{{loading}}" disabled="{{loading}}" bindtap="onSaveProfile">保存资料</button>
      <button class="skip-button" disabled="{{loading}}" bindtap="onSkipProfile">暂时跳过</button>
    </view>
  </view>
</view>
