.sheet-page { padding: 15px; }
.config { background: #fff; border-radius: 8px; padding: 15px; }
.title-row { display: flex; justify-content: space-between; padding: 10px 0; }
.title-row .link { color: #1aad19; }
.field { margin: 15px 0; }
.field .label { display: block; font-size: 14px; color: #666; margin-bottom: 5px; }
.field radio-group { display: flex; gap: 15px; }
.primary { background: #1aad19; color: #fff; margin-top: 15px; }
.result { background: #fff; border-radius: 8px; padding: 20px; text-align: center; margin-top: 15px; }
.result .success { font-size: 18px; display: block; margin-bottom: 15px; }
.result button { margin: 8px 0; }
.history { margin-top: 20px; }
.section-title { font-size: 14px; color: #999; padding: 10px 0; }
.history-item { background: #fff; border-radius: 8px; padding: 15px; margin-bottom: 8px; }
.history-main { display: flex; flex-direction: column; gap: 6px; }
.history-title { color: #333; font-size: 16px; }
.history-time { color: #999; font-size: 13px; }
.history-status { display: flex; gap: 12px; color: #777; font-size: 12px; }
.history-actions { display: flex; gap: 10px; margin-top: 12px; }
.history-actions button { flex: 1; margin: 0; }
.history-actions .result-action { color: #fff; background: #1aad19; }
.generation-card { margin: 14px 0; padding: 18px; border-radius: 12px; background: #fff; border-left: 4px solid #1aad19; display: flex; flex-direction: column; gap: 10px; }
.generation-card.failed { border-left-color: #e64340; }
.generation-title { font-size: 17px; font-weight: 600; color: #333; }
.generation-title.error, .generation-error { color: #e64340; }
.generation-help { color: #777; font-size: 14px; line-height: 1.5; }
.generation-actions { display: flex; gap: 10px; }
.generation-actions button { flex: 1; margin: 0; }
