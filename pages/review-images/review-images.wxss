.review-page { padding: 12px; padding-bottom: 32px; }
.state { padding: 48px 0; text-align: center; color: #999; }
.group-scroll { white-space: nowrap; margin-bottom: 12px; }
.group-tabs { display: inline-flex; }
.group-tab { display: inline-flex; align-items: center; margin-right: 8px; padding: 5px 10px 5px 5px; border-radius: 16px; background: #f3f3f3; color: #666; font-size: 12px; }
.group-tab.active { background: #fff1cf; color: #956c17; }
.group-thumbnail { width: 24px; height: 24px; margin-right: 5px; border-radius: 12px; }
.source-card, .question-card { margin-bottom: 12px; padding: 14px; border-radius: 10px; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
.source-card { background: #fff8e1; }
.source-title, .source-copy, .label { display: block; }
.source-title { color: #765615; font-weight: 600; }
.source-copy, .label { margin-top: 6px; color: #8d805f; font-size: 12px; }
.empty-answer { color: #c77700; font-size: 14px; line-height: 1.6; }
.original { width: 100%; margin-top: 10px; border-radius: 6px; }
.bulk-actions, .decision-row { display: flex; gap: 8px; margin-bottom: 12px; }
.bulk-actions button, .decision-row button { flex: 1; margin: 0; font-size: 13px; background: #fff; color: #666; }
.reprocess { margin: 0 0 12px; color: #956c17; background: #fff8e1; font-size: 13px; }
.question-title { display: block; margin-bottom: 8px; color: #333; font-weight: 600; }
.crop { width: 100%; margin-bottom: 10px; border-radius: 6px; }
.load-crop { margin: 0 0 10px; color: #765615; background: #fff; font-size: 13px; }
.crop-loading, .review-reason { display: block; margin: 8px 0; color: #8d805f; font-size: 12px; }
.selected.collect { background: #1aad19; color: #fff; }
.selected.ignore { background: #777; color: #fff; }
.submit { background: #1aad19; color: #fff; }
.confirm-fields { margin-top: 12px; padding: 12px; border-radius: 8px; background: #f7f9f6; }
.confirm-fields input { margin-top: 8px; padding: 9px 10px; border: 1rpx solid #e4e8e2; border-radius: 6px; background: #fff; font-size: 13px; }
.field-hint { color: #66705f; font-size: 12px; line-height: 1.5; }
.type-picker { margin-top: 8px; padding: 9px 10px; border: 1rpx solid #e4e8e2; border-radius: 6px; background: #fff; color: #66705f; font-size: 13px; }
.empty-review { margin: 12px 0; padding: 14px; border-radius: 8px; background: #fff8e1; color: #765615; font-size: 13px; line-height: 1.6; }
.add-missed { margin: 0 0 12px; color: #765615; background: #fff8e1; font-size: 14px; }
.issue-card { margin-bottom: 12px; padding: 16px; border-radius: 10px; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
.issue-title, .issue-message { display: block; }
.issue-title { margin-bottom: 6px; color: #765615; font-weight: 600; }
.issue-message { margin-bottom: 14px; color: #666; font-size: 13px; line-height: 1.6; }
.issue-card > button { margin-bottom: 10px; color: #765615; background: #fff8e1; font-size: 13px; }
.secondary-actions { display: flex; gap: 8px; }
.secondary-actions button { flex: 1; margin: 0; color: #666; background: #f5f5f5; font-size: 13px; }
