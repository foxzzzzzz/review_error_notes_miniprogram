.manual-page { min-height: 100vh; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); background: #f5f6f4; }
.step-content { padding: 24rpx; }
.instruction-card, .adjust-card { margin-bottom: 20rpx; padding: 24rpx; border-radius: 18rpx; background: #fff; }
.step-title, .step-copy { display: block; }
.step-title { margin-bottom: 8rpx; color: #29392e; font-size: 34rpx; font-weight: 650; }
.step-copy { color: #66716a; font-size: 26rpx; line-height: 1.6; }
.selection-tools, .adjust-row, .form-actions { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.selection-tools button, .adjust-row button, .form-actions button { flex: 1; margin: 0; padding: 0 6rpx; color: #45624c; background: #fff; font-size: 23rpx; }
.image-scroll { height: 62vh; border-radius: 12rpx; background: #e9ece9; }
.image-stage { position: relative; width: 100%; }
.source-image { display: block; width: 100%; }
.corner-marker { position: absolute; z-index: 2; width: 44rpx; height: 44rpx; margin: -22rpx 0 0 -22rpx; border: 3rpx solid #fff; border-radius: 50%; background: #d9534f; color: #fff; text-align: center; line-height: 44rpx; font-size: 23rpx; }
.selection-box { position: absolute; box-sizing: border-box; border: 4rpx solid #e34d59; background: rgba(227,77,89,.12); pointer-events: none; }
.selection-box text { padding: 3rpx 8rpx; background: #e34d59; color: #fff; font-size: 21rpx; }
.adjust-card { margin-top: 18rpx; color: #66716a; font-size: 23rpx; line-height: 1.6; }
.adjust-row { margin: 12rpx 0; }
.preview-label { display: block; margin: 12rpx 0; color: #344b39; font-weight: 600; }
.crop-preview, .form-preview { display: block; width: 100%; max-height: 340rpx; margin: 12rpx auto; border-radius: 10rpx; background: #f0f1ee; }
.preview-canvas { position: fixed; left: -1000px; top: -1000px; width: 600px; height: 360px; }
.primary-button { margin: 14rpx 0 0; color: #fff; background: #35834a; }
.continue-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 5; padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.08); }
.continue-bar .primary-button { margin: 0; }
.step-content input { margin: 16rpx 0; padding: 22rpx; border: 1rpx solid #dce3dc; border-radius: 12rpx; background: #fff; font-size: 27rpx; }
.type-picker { margin: 16rpx 0; padding: 22rpx; border: 1rpx solid #dce3dc; border-radius: 12rpx; background: #fff; color: #66716a; font-size: 27rpx; }
.form-actions { margin-top: 24rpx; }
.form-actions .primary-button { margin: 0; }
.suggestion-card { margin: 16rpx 0; padding: 18rpx 22rpx; border-radius: 12rpx; background: #eef5ef; color: #45624c; font-size: 24rpx; line-height: 1.6; }
.suggestion-card text { display: block; }
.suggestion-card .ocr-draft { margin: 8rpx 0; color: #657269; }
